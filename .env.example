# ===========================================
# SoluPark - Variables de Entorno
# ===========================================
# Copia este archivo a .env y configura los valores

# Django Settings
# ----------------
# Genera una nueva SECRET_KEY con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,solupark.shop,www.solupark.shop

# Database Configuration
# ----------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=require

# Redis Cache (opcional)
# ----------------------
REDIS_URL=redis://localhost:6379/0

# Email Configuration
# -------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Security Settings
# -----------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# SuperAdmin
# ----------
SUPERADMIN_EMAIL=admin@solupark.shop

# Render/Cloud Settings
# ---------------------
RENDER_EXTERNAL_HOSTNAME=
