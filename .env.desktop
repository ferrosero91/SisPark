# SoluPark Desktop - Configuración Local
SECRET_KEY=desktop-local-key-change-this-in-production-xyz789
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos local (SQLite)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=solupark_local.db

# Seguridad desactivada (es local)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# SuperAdmin local
SUPERADMIN_EMAIL=admin@local.com

# ============================================
# SINCRONIZACIÓN CON LA NUBE (opcional)
# ============================================
# Descomenta y configura para habilitar sincronización

# URL del servidor remoto
# SOLUPARK_SYNC_URL=https://tu-servidor.com

# Token de autenticación para sincronización
# SOLUPARK_SYNC_TOKEN=tu-token-aqui

# Intervalo de sincronización en segundos (default: 60)
# SOLUPARK_SYNC_INTERVAL=60
