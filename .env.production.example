# ===========================================
# SoluPark - Variables de Producción
# ===========================================
# Copia este archivo a .env.production

# Django Settings
SECRET_KEY=genera-una-clave-secreta-muy-larga-y-segura-aqui
DEBUG=False
ALLOWED_HOSTS=solupark.gestionxpress.app,localhost

# Database PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=solupark
DB_USER=solupark
DB_PASSWORD=tu_password_seguro_aqui
DB_HOST=db
DB_PORT=5432
DB_SSL_MODE=prefer

# Redis Cache
REDIS_URL=redis://redis:6379/0

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://solupark.gestionxpress.app

# SuperAdmin
SUPERADMIN_EMAIL=admin@gestionxpress.app
